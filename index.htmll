<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Тебе письмо</title>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Montserrat:wght@400;600&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: linear-gradient(135deg, #2b0818, #52122b, #2b0818);
            font-family: 'Montserrat', sans-serif;
            color: #fff;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow-x: hidden;
            padding: 20px;
        }

        /* Контейнер вопроса */
        .card {
            background: rgba(255, 255, 255, 0.07);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            padding: 30px 20px;
            border-radius: 24px;
            text-align: center;
            max-width: 400px;
            width: 100%;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 20px rgba(230, 83, 133, 0.3);
            animation: fadeIn 1s ease-in-out;
        }

        h2 {
            font-size: 20px;
            font-weight: 400;
            margin-bottom: 25px;
            color: #f1d1d8;
        }

        input {
            width: 100%;
            padding: 14px;
            border-radius: 30px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            font-size: 16px;
            text-align: center;
            outline: none;
            margin-bottom: 15px;
            transition: 0.3s;
        }

        input::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }

        input:focus {
            border-color: #ff7597;
            box-shadow: 0 0 10px rgba(255, 117, 151, 0.5);
        }

        button {
            width: 100%;
            padding: 14px;
            border-radius: 30px;
            border: none;
            background: linear-gradient(90deg, #ff416c, #ff4b2b);
            color: white;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(255, 65, 108, 0.4);
            transition: 0.3s;
        }

        button:active {
            transform: scale(0.98);
        }

        .error-message {
            color: #ff7597;
            font-size: 14px;
            margin-top: 10px;
            display: none;
        }

        /* Экран с письмом и конвертом */
        .hidden {
            display: none !important;
        }

        .envelope-wrapper {
            cursor: pointer;
            text-align: center;
            animation: pulse 2s infinite;
        }

        .envelope {
            width: 180px;
            height: 120px;
            background: #e0a96d;
            margin: 0 auto 20px;
            position: relative;
            border-radius: 8px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.4);
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .envelope::before {
            content: '';
            position: absolute;
            top: 0;
            border-left: 90px solid transparent;
            border-right: 90px solid transparent;
            border-top: 65px solid #c89257;
        }

        .stamp {
            width: 36px;
            height: 36px;
            background: #bd2a42;
            border-radius: 50%;
            position: absolute;
            top: 45px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.3);
        }

        .envelope-title {
            font-family: 'Caveat', cursive;
            font-size: 28px;
            color: #ffccd5;
        }

        /* Открытое письмо */
        .letter-card {
            background: #fff0f3;
            color: #2b0818;
            padding: 30px 25px;
            border-radius: 20px;
            max-width: 420px;
            width: 100%;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
            font-family: 'Caveat', cursive;
            text-align: left;
            position: relative;
            animation: openLetter 0.8s ease-out forwards;
            max-height: 85vh;
            overflow-y: auto;
        }

        .letter-header {
            font-size: 20px;
            color: #777;
            margin-bottom: 12px;
            font-family: 'Montserrat', sans-serif;
            border-bottom: 1px solid rgba(0,0,0,0.1);
            padding-bottom: 8px;
        }

        .letter-body {
            font-size: 24px;
            line-height: 1.4;
            white-space: pre-line;
            color: #333;
        }

        /* Сердечки */
        .heart {
            position: fixed;
            color: #ff416c;
            font-size: 20px;
            user-select: none;
            pointer-events: none;
            animation: floatUp 3s linear forwards;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes openLetter {
            from { opacity: 0; transform: scale(0.8) translateY(30px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        @keyframes floatUp {
            0% { opacity: 1; transform: translateY(0) scale(1); }
            100% { opacity: 0; transform: translateY(-100vh) scale(1.5); }
        }
    </style>
</head>
<body>

    <!-- Шаг 1: Вопрос -->
    <div id="quiz-step" class="card">
        <h2>Когда ты уехала в Россию?</h2>
        <input type="text" id="answer-input" placeholder="Введите дату..." autocomplete="off">
        <button onclick="checkAnswer()">Открыть</button>
        <div id="error-msg" class="error-message">Неправильно, подумай еще!</div>
    </div>

    <!-- Шаг 2: Конверт -->
    <div id="envelope-step" class="envelope-wrapper hidden" onclick="openLetter()">
        <div class="envelope">
            <div class="stamp"></div>
        </div>
        <div class="envelope-title">Тебе письмо ❤️ (нажми)</div>
    </div>

    <!-- Шаг 3: Текст письма -->
    <div id="letter-step" class="letter-card hidden">
        <div id="letter-header" class="letter-header"></div>
        <div class="letter-body">
Привет! Когда ты приедешь? Мы тебя с Кошариком очень ждем приезжай быстрее! 

Помнишь как мы ночью смеялись от пиццы? И как облизывал потом кровать Кошарик от жира? А помнишь молнию? Как мы оставили открытым окно я уснул и БАААМ! 

Я тебя очень жду!
        </div>
    </div>

    <script>
        function checkAnswer() {
            const input = document.getElementById('answer-input').value.trim().toLowerCase();
            const errorMsg = document.getElementById('error-msg');
            
            if (
                input.includes('17 сентября') || 
                input.includes('17.09') || 
                input.includes('семнадцатое') || 
                input.includes('17')
            ) {
                document.getElementById('quiz-step').classList.add('hidden');
                document.getElementById('envelope-step').classList.remove('hidden');
                createHearts();
            } else {
                errorMsg.style.display = 'block';
            }
        }

        function openLetter() {
            document.getElementById('envelope-step').classList.add('hidden');
            
            // Расчет дней с 17 сентября
            const now = new Date();
            // Месяцы в JS с 0, поэтому сентябрь = 8
            const departureDate = new Date(now.getFullYear(), 8, 17);
            
            // Если сегодня раньше 17 сентября этого года, берем прошлый год
            if (now < departureDate) {
                departureDate.setFullYear(now.getFullYear() - 1);
            }
            
            const diffTime = now - departureDate;
            const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));

            // Функция правильного склонения слова "день"
            function getDayWord(days) {
                let n = Math.abs(days) % 100;
                let n1 = n % 10;
                if (n > 10 && n < 20) return 'дней';
                if (n1 > 1 && n1 < 5) return 'дня';
                if (n1 == 1) return 'день';
                return 'дней';
            }

            // Формируем шапку письма
            const headerText = `Уже прошло ${diffDays} ${getDayWord(diffDays)} как ты уехала`;
            document.getElementById('letter-header').innerText = headerText;

            document.getElementById('letter-step').classList.remove('hidden');
            createHearts();
        }

        function createHearts() {
            for (let i = 0; i < 25; i++) {
                setTimeout(() => {
                    const heart = document.createElement('div');
                    heart.classList.add('heart');
                    heart.innerHTML = '❤️';
                    heart.style.left = Math.random() * 100 + 'vw';
                    heart.style.bottom = '0px';
                    heart.style.fontSize = (Math.random() * 20 + 15) + 'px';
                    heart.style.animationDuration = (Math.random() * 2 + 2) + 's';
                    document.body.appendChild(heart);

                    setTimeout(() => heart.remove(), 3000);
                }, i * 100);
            }
        }
    </script>
</body>
</html>
